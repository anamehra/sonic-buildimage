{%- macro generate_scheduler_config() %}
    "SCHEDULER": {
        "scheduler.0": {
            "type"  : "DWRR",
            "weight": "10"
        },
        "scheduler.1": {
            "type"  : "DWRR",
            "weight": "20"
        },
        "scheduler.2": {
            "type"  : "DWRR",
            "weight": "70"
        }
    },
{%- endmacro %}

{%- macro generate_queue_config(port_names) %}
    "QUEUE": {
{% for port in port_names.split(',') %}
{% set port_loop = loop %}
{% for tc in ['0','1','2'] %}
        "{{ port }}|{{ tc }}": {
            "scheduler": "scheduler.0"
        },
{% endfor %}
{% for tc in ['3'] %}
        "{{ port }}|{{ tc }}": {
            "scheduler": "scheduler.1",
            "wred_profile": "AZURE_LOSSLESS"
        },
{% endfor %}
{% for tc in ['4'] %}
        "{{ port }}|{{ tc }}": {
            "scheduler": "scheduler.0",
            "wred_profile": "AZURE_LOSSLESS"
        },
{% endfor %}
{% for tc in ['5'] %}
        "{{ port }}|{{ tc }}": {
            "scheduler": "scheduler.0"
        },
{% endfor %}
         "{{ port }}|6": {
            "scheduler": "scheduler.2"
        }{% if not loop.last %},
{% endif %}
{% endfor %}

    }
{%- endmacro %}

{%- macro generate_qos_bypass_port_list(PORT_QOS_BYPASS) %}
    {% for port in PORT %}
       {% if 'lanes' in PORT[port] %}
          {% if PORT[port]['lanes'] | int >= 0xfff0 %}
             {% set _ = PORT_QOS_BYPASS.append(port) %}
          {% endif %}
       {% endif %}
    {% endfor %}
{%- endmacro %}

