{%- endmacro %}

{%- macro generate_queue_config(port_names) %}
    "QUEUE": {
{% for port in port_names.split(',') %}
{% set port_loop = loop %}
{% for tc in ['0','1','2'] %}
        "{{ port }}|{{ tc }}": {
            "scheduler": "scheduler.{{ tc }}",
            "wred_profile": "AZURE_LOSSY"
        },
{% endfor %}
{% for tc in ['3','4'] %}
        "{{ port }}|{{ tc }}": {
            "scheduler": "scheduler.{{ tc }}",
            "wred_profile": "AZURE_LOSSLESS"
        },
{% endfor %}
{% for tc in ['5','6'] %}
        "{{ port }}|{{ tc }}": {
            "scheduler": "scheduler.{{ tc }}",
            "wred_profile": "AZURE_LOSSY"
        },
{% endfor %}
         "{{ port }}|7": {
            "scheduler": "scheduler.7"
        }{% if not loop.last %},
{% endif %}
{% endfor %}
    }
{%- endmacro %}

{%- macro generate_qos_bypass_port_list(PORT_QOS_BYPASS) %}
    {% for port in PORT %}
       {% if 'lanes' in PORT[port] %}
          {% if PORT[port]['lanes'] | int >= 0xfff0 %}
             {% set _ = PORT_QOS_BYPASS.append(port) %}
          {% endif %}
       {% endif %}
    {% endfor %}
{%- endmacro %}

