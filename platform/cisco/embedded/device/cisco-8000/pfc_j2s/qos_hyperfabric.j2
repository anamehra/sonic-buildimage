{%- macro generate_port_qos_map(port_names) %}
    "PORT_QOS_MAP": {
{% for port in port_names.split(',') %}

    "{{ port }}": {
            "tc_to_pg_map": "AZURE",
            "pfc_to_pg_map": "AZURE",
            "pfc_enable": "3,4",
            "pfcwd_sw_enable": "3,4",
            "pfc_to_queue_map": "AZURE",
            "dscp_to_tc_map": "AZURE",
            "tc_to_queue_map": "AZURE"
        }{% if not loop.last %},{% endif %}
{% endfor %}
    },
{%- endmacro %}

