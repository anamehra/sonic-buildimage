            "weight": "20"
        },
        "scheduler.1": {
            "type"  : "DWRR",
            "weight": "20"
        },
        "scheduler.2": {
            "type"  : "DWRR",
            "weight": "20"
        },
        "scheduler.3": {
            "type"  : "DWRR",
            "weight": "40"
        },
        "scheduler.4": {
            "type"  : "DWRR",
            "weight": "40"
