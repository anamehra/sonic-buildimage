#!/bin/bash

set -u

FSTRIM=/sbin/fstrim
VAR_LOG_IMAGE=/host/disk-img/var-log.ext4

is_fully_allocated_file()
{
    local file="$1"
    local size blocks block_size allocated

    if [ ! -f "$file" ]; then
        return 1
    fi

    read -r size blocks block_size < <(stat -c '%s %b %B' "$file") || return 1
    allocated=$((blocks * block_size))

    [ "$size" -gt 0 ] && [ "$allocated" -ge "$size" ]
}

is_ubi_host()
{
    [ "$(findmnt -rn -o FSTYPE /host 2>/dev/null)" = "ubifs" ]
}

should_skip_mount()
{
    local target="$1"

    [ "$target" = "/var/log" ] &&
        is_ubi_host &&
        is_fully_allocated_file "$VAR_LOG_IMAGE"
}

rc=0

while read -r target fstype options; do
    case ",$options," in
        *,ro,*)
            continue
            ;;
    esac

    if should_skip_mount "$target"; then
        echo "Skipping fstrim for $target backed by fully allocated $VAR_LOG_IMAGE"
        continue
    fi

    "$FSTRIM" -v --quiet-unsupported "$target" || rc=$?
done < <(findmnt -rn -o TARGET,FSTYPE,OPTIONS)

exit "$rc"
